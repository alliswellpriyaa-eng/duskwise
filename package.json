{
  "name": "duskwise",
  "version": "0.1.0",
  "description": "Comfort-first CSS library whose theme adapts to the time of day, sunset and weather.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/duskwise.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./duskwise.css": "./dist/duskwise.css",
    "./duskwise.min.css": "./dist/duskwise.min.css",
    "./tokens.css": "./src/css/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "tokens": "node tokens/build-tokens.mjs",
    "build:css": "npm run tokens && node tokens/build-css.mjs",
    "build:js": "tsup",
    "build": "rm -rf dist && npm run build:css && npm run build:js",
    "build:demo": "npm run build && node demo/build-demo.mjs",
    "test": "vitest run",
    "typecheck": "tsc",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "css",
    "theme",
    "dark-mode",
    "night-mode",
    "design-tokens",
    "oklch",
    "accessibility"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "Shanmugapriya Mithun Chakravarthy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alliswellpriyaa-eng/duskwise.git"
  },
  "homepage": "https://github.com/alliswellpriyaa-eng/duskwise#readme",
  "bugs": {
    "url": "https://github.com/alliswellpriyaa-eng/duskwise/issues"
  }
}
